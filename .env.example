# .env.example — ai-devsecops-agent-mcp
# Copy to .env and fill in values to activate live backends. Leave blank for mock mode.
#
# ┌─────────────────────────────────────────────────────────────────────────┐
# │  PROGRESSIVE CREDENTIAL LOADING (PCL)                                   │
# │  No keys needed to run. Add keys to unlock production-grade backends.   │
# └─────────────────────────────────────────────────────────────────────────┘

# ── GitHub Actions Integration ───────────────────────────────────────────
# UNSET (default): Mock CI/CD runs & pipeline status (CI-safe)
# SET to GitHub PAT: Live GitHub Actions workflow query
GITHUB_TOKEN=
GITHUB_REPO=

# ── Kubernetes Cluster Integration ────────────────────────────────────────
# UNSET (default): Mock cluster events & Prometheus metrics
# SET to path: Live in-cluster or kubeconfig event streaming
KUBECONFIG=
PROMETHEUS_URL=

# ── Server ────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
